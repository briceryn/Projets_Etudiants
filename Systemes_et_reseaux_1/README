├── logs/ # Dossier des fichiers de log
│ └── parties.log # Historique des parties
└── README.md # Documentation

## Protocoles de communication

### Tubes nommes (FIFOs) pour communication locale

```c
int creer_fifo(const char* chemin);
int ouvrir_fifo(const char* chemin, int mode);
int envoyer_fifo(int fd, const void* data, size_t taille);
int recevoir_fifo(int fd, void* data, size_t taille, int timeout_sec);

Sockets TCP pour communication reseau
int creer_serveur_tcp(int port);
int accepter_connexion_tcp(int sock_serveur, char* ip_client, int* port_client);
int connecter_client_tcp(const char* adresse, int port);
int envoyer_tcp(int socket, const void* data, size_t taille);
int recevoir_tcp(int socket, void* buffer, size_t taille_max, int timeout_sec);

Structure des messages
typedef struct {
    int type;
    int id_joueur;
    int id_partie;
    union {
        Carte carte;
        int score;
        int choix;
        char message[256];
    } donnees;
} Message;

enum TypeMessage {
    MSG_DEMANDE_CARTE = 1,
    MSG_CARTE_JOUE = 2,
    MSG_INFO_PARTIE = 3,
    MSG_SCORE = 4,
    MSG_FIN_MANCHE = 5,
    MSG_FIN_PARTIE = 6,
    MSG_ERREUR = 7,
    MSG_PING = 8,
    MSG_CONFIRMATION = 9
};

Semaphores pour synchronisation
c
SemaphoreJeu* creer_semaphores(int nb_sem, int valeur_init);
void sem_wait_jeu(SemaphoreJeu* sem, int num_sem);   // Operation P
void sem_signal_jeu(SemaphoreJeu* sem, int num_sem); // Operation V

Structures de donnees
Carte
typedef struct {
    int valeur;          // De 1 a 104
    int tetes_de_boeuf;  // 1, 2, 3, 5 ou 7 têtes
} Carte;

Rangee

typedef struct {
    Carte cartes[NB_MAX_CARTES_RANGEE];  // 6 cartes max
    int nb_cartes;
    int total_tetes;
} Rangee;

Joueur

typedef struct {
    int id;
    char nom[TAILLE_NOM];
    int score;
    Carte main[NB_CARTES_MAIN];  // 10 cartes par manche
    int nb_cartes_main;
    int est_robot;
    int est_actif;
} Joueur;

Partie

typedef struct {
    int id_partie;
    Joueur* joueurs[MAX_JOUEURS];  // max 10 joueurs
    int nb_joueurs;
    Rangee rangees[NB_RANGEES];    // 4 rangees
    Carte pioche[NB_CARTES_TOTAL]; // 104 cartes
    int manche_actuelle;
    int tour_actuel;
    int joueur_actif;
    int partie_terminee;
    int gagnant_id;
} Partie;
